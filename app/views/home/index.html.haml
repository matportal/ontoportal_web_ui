- @title = t("home.index.title", organization: "#{$ORG_SITE}")

- unless $FRONT_NOTICE.nil? || $FRONT_NOTICE.empty? || cookies[:front_page_notice_closed].eql?("true")
  :javascript
    function close_message(){
      var exdate = new Date();
      exdate.setDate(exdate.getDate() + 7);
      document.cookie="front_page_notice_closed=true; expires="+exdate.toGMTString();
      jQuery("#notice_message").hide();
    }

  %p#notice_message{style: "padding: 10px; margin: 10px; border:1px solid #EFEFEF; background-color: #F9F9F9;"}
    = $FRONT_NOTICE
    \&nbsp;&nbsp;
    %a{href: "#", onclick: "close_message(); return false;", style: "font-size: small; color: darkGray;"} [close]

.home-header-container
  .home-header-background
  .home-bubbles
    .home-random-bubbles
      %img{src: asset_path("home-random-bubbles.svg")}/

  .home-header-title-container
    .home-header-title
      %h4= t("home.index.welcome", site: $SITE)
      %p= t("home.index.tagline")
      .search-inputs
        = form_tag(search_path, method: "get") do
          = text_field_tag("query", nil, placeholder: t("home.index.query_placeholder"), autocomplete: "off")

.home-body-container
  .home-section
    %h4 Do you want to share an ontology?
    %hr.home-section-line/
    %p Uploading and sharing on MatPortal helps others discover and reuse your work.
    .home-ontologies-actions
      .home-upload-ontology-button
        = upload_ontology_button
      .discover-ontologies
        = discover_ontologies_button

  .home-section
    %h4 MatPortal in figures
    %hr.home-section-line/
    .home-statistics-container
      - stats = [[@ont_count, "Ontologies"], [@cls_count, "Classes"], [@prop_count, "Properties"], [@map_count, "Mappings"]]
      .home-statistics
        - stats.each do |value, label|
          .home-statistics-item
            %hr
            %div
              %h4= number_with_delimiter(value)
              %p= label

  .home-section
    .home-section-title
      .text Support & Collaborations
      %hr.home-section-line/
    .home-support-items.matportal-collab-logos
      %a{href: "https://www.materials.fraunhofer.de/", target: "_blank", rel: "noopener noreferrer"}
        %img{src: "/matportal-logos/fraunhofer-materials.gif", alt: "Fraunhofer Materials"}
      %a{href: "https://www.bam.de/Navigation/DE/Home/home.html", target: "_blank", rel: "noopener noreferrer"}
        %img{src: "/matportal-logos/bam.png", alt: "BAM"}
      %a{href: "https://www.materialdigital.de/", target: "_blank", rel: "noopener noreferrer"}
        %img{src: "/matportal-logos/materialdigital.svg", alt: "MaterialDigital"}
      %a{href: "https://nfdi-matwerk.de/", target: "_blank", rel: "noopener noreferrer"}
        %img{src: "/matportal-logos/nfdi-matwerk.png", alt: "NFDI-MatWerk"}
      %a{href: "https://oagi.org/pages/industrial-ontologies", target: "_blank", rel: "noopener noreferrer"}
        %img{src: "/matportal-logos/oagi.png", alt: "OAGi Industrial Ontologies"}
      %a{href: "https://mat-o-lab.github.io/OrgSite/", target: "_blank", rel: "noopener noreferrer"}
        %img{src: "/matportal-logos/mat-o-lab.png", alt: "Mat-O-Lab"}

